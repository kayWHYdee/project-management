# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# All services (Postgres, API) read from the single root `.env` via compose.
# ---------------------------------------------------------------------------

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=waterpm
POSTGRES_PASSWORD=change_me_in_real_env
POSTGRES_DB=waterpm

# Connection string used by Prisma inside the api container.
# Host is the compose service name `db`. Application tables live in schema `pm`.
DATABASE_URL=postgresql://waterpm:change_me_in_real_env@db:5432/waterpm?schema=pm

# --- API --------------------------------------------------------------------
API_PORT=3000
NODE_ENV=production

# Secret used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=change_me_generate_with_openssl_rand_hex_32

# Cookie hardening. Set COOKIE_SECURE=true only when serving over HTTPS
# (Caddy Option A). On plain-HTTP LAN (Option B) it MUST be false or the
# browser will refuse to store the session cookie.
COOKIE_SECURE=false

# --- First owner bootstrap --------------------------------------------------
# The seed script creates this OWNER user only if no users exist yet.
# Change the password immediately after first login.
BOOTSTRAP_OWNER_NAME=Owner
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_PASSWORD=change_me_before_first_run

# --- Web build --------------------------------------------------------------
# The web app talks to the API via the Caddy reverse proxy at `/api`, so this
# is normally left as the relative default and needs no host.
VITE_API_BASE_URL=/api
